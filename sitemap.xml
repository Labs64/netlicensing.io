---
layout: compress
sitemap:
  exclude: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- generated-on="{{ site.time | date_to_rfc822 }}" -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {% comment %}
    Only indexable HTML documents are listed: redirect stubs, noindex pages,
    paginated archive pages and non-HTML assets (css, xml, txt) are skipped.
    lastmod is emitted only when it is actually known (sitemap.lastmod,
    last_modified_at or the document date) so that search engines keep trusting it.
  {% endcomment %}
  {% assign documents = site.posts | concat: site.pages | concat: site.case-studies %}
  {% for doc in documents %}
    {% if doc.published == false or doc.sitemap.exclude or doc.noindex or doc.layout == 'redirect' %}{% continue %}{% endif %}
    {% assign last_char = doc.url | slice: -1 %}
    {% assign last_ext = doc.url | slice: -5, 5 %}
    {% unless last_char == '/' or last_ext == '.html' %}{% continue %}{% endunless %}
    {% if doc.url contains '/blog/page' %}{% continue %}{% endif %}
    <url>
      <loc>{{ site.url }}{{ doc.url | remove: "index.html" }}</loc>
      {% if doc.sitemap.lastmod %}
        <lastmod>{{ doc.sitemap.lastmod | date: "%Y-%m-%d" }}</lastmod>
      {% elsif doc.last_modified_at %}
        <lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>
      {% elsif doc.date %}
        <lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>
      {% endif %}
      {% if doc.sitemap.changefreq %}
        <changefreq>{{ doc.sitemap.changefreq }}</changefreq>
      {% else %}
        <changefreq>weekly</changefreq>
      {% endif %}
      {% if doc.sitemap.priority %}
        <priority>{{ doc.sitemap.priority }}</priority>
      {% elsif doc.collection == 'posts' %}
        <priority>0.4</priority>
      {% elsif doc.collection == 'case-studies' %}
        <priority>0.6</priority>
      {% else %}
        <priority>0.5</priority>
      {% endif %}
      {% if doc.image.url %}
        {% include image4sitemap.html image=doc.image.url %}
      {% endif %}
      {% if doc.img %}
        {% include image4sitemap.html image=doc.img %}
      {% endif %}
      {% for doc_image in doc.sitemap.images %}
        {% include image4sitemap.html image=doc_image %}
      {% endfor %}
    </url>
  {% endfor %}
</urlset>
